# =============================================================================
# Shalona's Art — Environment Configuration Template
# =============================================================================
# Duplicate this file as `.env` or set these variables in your Vercel Project Settings:
# https://vercel.com/dashboard -> Project Settings -> Environment Variables

# --- Resend Email Inquiries API ---
# Used by /api/send-inquiry serverless function to forward art requests to shalonalei@gmail.com
RESEND_API_KEY=re_your_api_key_here

# --- Google Analytics 4 (GA4) ---
# Measurement ID format: G-XXXXXXXXXX
# When set, analytics scripts load automatically on production (shalonasart.ch)
VITE_GA_MEASUREMENT_ID=

# --- Google Tag Manager (GTM) ---
# Container ID format: GTM-XXXXXXX (Optional alternative to GA4)
VITE_GTM_CONTAINER_ID=

# --- Microsoft Clarity (Heatmaps & Session Recordings) ---
# Clarity Project ID from https://clarity.microsoft.com
VITE_CLARITY_PROJECT_ID=

# --- Search Engine Webmaster Verification Tags ---
# If verifying via HTML meta tag instead of DNS TXT records:
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=
